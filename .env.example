# Variáveis de ambiente para produção Docker
# Copie este arquivo para .env e preencha os valores

# Chave secreta JWT — MUDE ISSO em produção!
SECRET_KEY=mude-esta-chave-super-secreta-aqui-2024

# URL pública do backend (IP ou domínio da sua VPS)
# Exemplo com IP: http://123.456.789.0:8000
# Exemplo com domínio: https://api.seudominio.com
EXPO_PUBLIC_API_URL=http://SEU_IP_OU_DOMINIO:8000
